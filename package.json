{
  "name": "auto-main",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous FunTime auto-mine farm controller on SoulFire",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/src/index.js",
  "bin": {
    "auto-main": "dist/src/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.3",
    "@soulfiremc/sdk": "2.10.7",
    "effect": "4.1.4",
    "pino": "10.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
