# SoulFire backend (deployed on the VDS)
SF_BASE_URL=https://217.60.33.212
# API token: generate in the SoulFire console with `generate-token api`
SF_TOKEN=
# Instance friendly name or UUID
SF_INSTANCE=ft
# Bot account name or profile UUID (optional; if omitted, the only online bot is used)
SF_BOT=

# Mines API
MINES_API_URL=https://funtime.me/api/backend/api/v1/plugin/mines
MINES_SERVER_TYPES=all
MINES_POLL_INTERVAL_MS=7000

# Base access. The clan home is registered on ONE anarchy only (the main one),
# so the bot must switch there before `/clan home`. That anarchy is never farmed.
BASE_HOME_COMMAND=/clan home
BASE_HOME_ANARCHY=302

# Target selection
TARGET_STRATEGY=timer
TARGET_TRAVEL_MS=25000
TARGET_MIN_LEAD_MS=10000
TARGET_MAX_LEAD_MS=90000
TARGET_RARITY=legendary,mythical,default

# Runtime
DATA_DIR=var
LOG_LEVEL=info

# Test mode: skip base trips (drop/repair), stop when inventory is full
TEST_MODE=false

# Telemetry
LOG_FILE=var/controller.log
RUNS_FILE=var/runs.jsonl
